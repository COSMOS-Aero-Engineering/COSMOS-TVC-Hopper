# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Node (pptx 생성기)
node_modules/
package-lock.json
# 웹 뷰어는 lock 파일로 버전을 고정한다
!/web/package-lock.json
/web/dist/

# AI 에이전트 도구가 만드는 로컬 상태 (커밋 대상 아님)
.omc/

# tasks.py 작업 캐시 (입력 해시 마커만 들어 있다 — 지워도 무해, 다시 만들어진다)
.cosmos-cache/

# OS
.DS_Store
Thumbs.db

# 빌드/출력물
*.stl
*.gcode
/sim/runs/
/sim/logs/
/sim/sim_stage1/episode_logs/
# 커넥톰 그래프는 build_subgraph.py가 결정론적으로 다시 만든다 (python tasks.py connectome)
/sim/connectome/graphs/
/sim/connectome/results/
*.pdf.tmp

# PlatformIO 빌드 캐시 (firmware/cosmos/*/platformio.ini 프로젝트마다 생김)
.pio/
.pioenvs/
.piolibdeps/
# pio device monitor --filter log2file 출력. 남길 로그는 data/로 옮겨 커밋한다
/firmware/cosmos/*/logs/

# KiCad 로컬 상태 (#68). 커밋 대상 아님
# .kicad_prl: 사용자별 화면 설정. KiCad 공식 문서가 버전 관리에서 빼도 된다고 한다
# ~*.lck: 프로젝트를 열어 둔 동안만 있는 잠금 파일. KiCad를 닫으면 지워진다
*.kicad_prl
~*.lck

# 예외: 외주 업체에 실제로 보낸 STL은 기록으로 남긴다
# (출력물이 이상할 때 "우리가 보낸 파일이 이거였나"를 확인할 유일한 근거)
!/cad/print-orders/**/*.stl
